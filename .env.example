# ──────────────────────────────────────────────────────────────────────
# Backend environment template
#
#   cp .env.example .env
#
# `.env` is gitignored — never commit real credentials. The defaults
# below match docker-compose.yml, so `docker compose up -d db` plus
# these values works out of the box.
#
# Spring Boot does not read `.env` on its own. Either export these into
# your shell before `./mvnw spring-boot:run`, or set them as service
# environment variables on Render. See RENDER_DEPLOYMENT.md.
# ──────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/crop_advisory
DB_USER=postgres
DB_PASSWORD=password123

# Render supplies a single DATABASE_URL instead of the three above
# (format: postgresql://user:pass@host:port/db). DataSourceConfig
# normalises it to JDBC form and extracts the credentials, so this
# alone is enough in production. Uncomment to test that path locally.
# DATABASE_URL=

# ── JWT ───────────────────────────────────────────────────────────────
# Must be at least 256 bits (32+ characters), or the app fails to start
# with "JWT signing key must be at least 256 bits".
# Generate a real one with:  openssl rand -base64 32
JWT_SECRET=change_me_generate_with_openssl_rand_base64_32
JWT_EXPIRATION_MS=86400000

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated frontend origins, no trailing slash. Must include
# every origin that calls the API, or requests fail with 403.
# Production example:
#   FRONTEND_URL=https://your-app.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── Admin bootstrap ───────────────────────────────────────────────────
# Signup only offers FARMER and OFFICER, so these create the first ADMIN
# account on startup. The seeder runs only when BOTH are set, and only when
# no admin exists yet, so it is safe to leave configured.
# Leave blank to skip admin bootstrap entirely.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password

# ── Optional ──────────────────────────────────────────────────────────
# DDL_AUTO: update | validate | create-drop  (use validate in production)
DDL_AUTO=update
# SHOW_SQL: log every SQL statement (handy when debugging)
SHOW_SQL=false
# PORT: Render injects this automatically
PORT=8080

# ── Frontend ──────────────────────────────────────────────────────────
# The React app has its own template: frontend/.env.example
#   VITE_API_BASE_URL=http://localhost:8080/api
