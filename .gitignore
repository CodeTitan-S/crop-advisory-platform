# Uploaded files (backend/app.upload.dir)
uploads/

# Environments & Secrets
.env
.venv
env/
venv/
*.env

# Java
target/
!.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
*.ear

# Node / React (Frontend)
node_modules/
dist/
build/
.npm/

# Machine Learning / Jupyter
.ipynb_checkpoints
*.h5
# Trained model artifacts: ignored everywhere except the ml-service model dir,
# which the ML service image needs baked in at deploy time (*.pkl was previously
# ignored wholesale, so the files never reached Render and uvicorn crashed on
# import with FileNotFoundError — see model_loader.py).
*.pkl
!ml-service/model/*.pkl
*.pt
*.onnx

# Datasets (Keep large CSVs and images out of version control)
ml/data/
*.csv
*.zip

# OS generated files
.DS_Store
Thumbs.db

# IDE
.idea/
*.iml
.vscode/

# Test results
backend/test_results.txt
